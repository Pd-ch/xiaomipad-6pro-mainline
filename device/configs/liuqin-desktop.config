# Product test automation uses a virtual absolute touchscreen and keyboard to
# drive the real Mutter/Wayland input path.  AT-SPI handles semantic controls;
# uinput covers coordinate gestures and GNOME's trusted screenshot shortcut.
CONFIG_INPUT_UINPUT=y

# qcom_socinfo is a runtime dependency of the SSC reverse filesystem.  A
# module-only build without a matching module tree leaves /sys/devices/soc0
# absent and forces the sensor DSP down its Android registry-rebuild path.
CONFIG_QCOM_SOCINFO=y

# systemd-oomd requires /proc/pressure/memory.
CONFIG_PSI=y

# Bluetooth PAN, serial and HID profiles.
CONFIG_BT_BNEP=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
