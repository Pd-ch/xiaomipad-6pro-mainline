# Snap confinement and desktop portal support.
# Build FUSE in so portals do not depend on module loading during startup.
CONFIG_FUSE_FS=y

# Strict snaps re-exec snap-confine from the mounted snapd SquashFS, not only
# from the ext4 package path.  Without xattr support the file's
# security.capability is invisible even though getcap on /usr/lib looks right.
CONFIG_SQUASHFS_XATTR=y

# Ubuntu's snap-confine is capability-backed, and strict snaps rely on the
# distribution AppArmor policy.  Selecting AppArmor alone is insufficient when
# an explicit CONFIG_LSM string omits it; make AppArmor the default major LSM
# and keep it in the ordered stack.
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,apparmor,ipe,bpf"
