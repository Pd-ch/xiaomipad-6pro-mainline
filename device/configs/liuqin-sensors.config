# liuqin SSC/automatic-rotation kernel fragment.
#
# SM8450 already describes the SLPI GLINK FastRPC endpoint and context banks
# in sm8450.dtsi.  The first-boot image has no module tree, so =m is the same
# as disabled at runtime.  Keep this as a tiny, independently auditable
# fragment until the SSC userspace has produced a real sample on hardware.
CONFIG_QCOM_FASTRPC=y
